<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The application manifest of ailimits.exe and ailimits-auth.exe (build.rs).
  Only what every Windows program is expected to say about itself:
  - it runs as the user who starts it, never asking for administrator rights
    (no installer-detection guess, no UAC prompt);
  - it was made for Windows 10 and 11 (Rust's minimum), so Windows does not
    run it in a compatibility mode.
  Deliberately nothing else: DPI awareness stays set at run time by the
  window library, and no Common Controls version is asked for, so nothing
  the user sees changes.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
